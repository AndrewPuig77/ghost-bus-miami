# Copy this file to .env and fill in the values. Never commit .env.

# Swiftly real-time API
SWIFTLY_API_KEY=
SWIFTLY_AGENCY=miami

# Postgres (PostGIS)
POSTGRES_USER=ghostbus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ghostbus
# Postgres cache size. Leave unset locally; about 25% of RAM on a server (e.g. 3GB).
# PG_SHARED_BUFFERS=3GB

# Port the map is served on: 8080 locally by default, 80 on the server.
# WEB_PORT=80
# With a domain pointed at the server, Caddy serves HTTPS for it automatically.
# SITE_ADDRESS=ghostbus.example.com

DATABASE_URL=postgresql+psycopg://ghostbus:change-me@db:5432/ghostbus

# Redis
REDIS_URL=redis://redis:6379/0

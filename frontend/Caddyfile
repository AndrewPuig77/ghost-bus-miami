# SITE_ADDRESS is ":80" for plain HTTP (local, or the server before it has a domain).
# Set it to a domain name and Caddy fetches and renews an HTTPS certificate itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Hashed asset files never change; index.html must always be re-checked.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
